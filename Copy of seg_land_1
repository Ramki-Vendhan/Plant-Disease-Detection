)  # Adjusted bounding boxes\n","\n","        return cls_logits, bbox_preds, rpn_cls_logits, rpn_bbox_pred\n","\n","model = fasterRCNN(num_classes=21)\n","x = torch.rand(1, 3, 224, 224)\n","cls_logits, bbox_preds, rpn_cls_logits, rpn_bbox_pred = model(x)\n","\n","print(cls_logits.shape, bbox_preds.shape)\n","from transformers import TFSegformerForSemanticSegmentation\n","\n","model_checkpoint = \"nvidia/mit-b1\"\n","id2label =  {0: \"outer\", 1: \"landslide\"}\n","label2id = {label: id for id, label in id2label.items()}\n","num_labels = len(id2label)\n","model = TFSegformerForSemanticSegmentation.from_pretrained(\n","    model_checkpoint,\n","    num_labels=num_labels,\n","    id2label=id2label,\n","    label2id=label2id,\n","    ignore_mismatched_sizes=True,\n","\n",")"],"metadata":{"execution":{"iopub.status.busy":"2024-10-28T19:31:23.146793Z","iopub.execute_input":"2024-10-28T19:31:23.14715Z","iopub.status.idle":"2024-10-28T19:31:40.891757Z","shell.execute_reply.started":"2024-10-28T19:31:23.147117Z","shell.execute_reply":"2024-10-28T19:31:40.890759Z"},"trusted":true,"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"l1PXr3UdnAC3","executionInfo":{"status":"error","timestamp":1778228098638,"user_tz":-330,"elapsed":24726,"user":{"displayName":"Ramki Vendhan","userId":"17740750095446136563"}},"outputId":"d1d6a2f5-233b-40d4-8e47-36c7c2040530"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Found existing installation: transformers 5.8.0\n","Uninstalling transformers-5.8.0:\n","  Successfully uninstalled transformers-5.8.0\n","Collecting transformers\n","  Using cached transformers-5.8.0-py3-none-any.whl.metadata (33 kB)\n","Requirement already satisfied: huggingface-hub<2.0,>=1.5.0 in /usr/local/lib/python3.12/dist-packages (from transformers) (1.11.0)\n","Requirement already satisfied: numpy>=1.17 in /usr/local/lib/python3.12/dist-packages (from transformers) (2.0.2)\n","Requirement already satisfied: packaging>=2